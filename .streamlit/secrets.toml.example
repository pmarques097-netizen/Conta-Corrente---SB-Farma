# Copie este conteúdo em Streamlit Cloud > App > Settings > Secrets

[app]
cloud = true
mode = "cloud"
# Ativa a persistência real do estado do app no PostgreSQL.
# Negociações, financeiro e comprovantes ficam protegidos contra reboot/redeploy.
state_sync = true
state_table = "sb_farma_app_state"
state_key = "projeto_negociacao_investimento"
state_max_mb = 80
state_sync_interval_seconds = 20

[postgres]
host = "SEU_HOST"
port = 5432
database = "SEU_BANCO"
user = "SEU_USUARIO"
password = "SUA_SENHA"

# Opcional: use outro banco apenas para persistir o estado do app.
# Se não informar, o sistema usa [postgres].
# [app_state_postgres]
# host = "SEU_HOST"
# port = 5432
# database = "SEU_BANCO"
# user = "SEU_USUARIO"
# password = "SUA_SENHA"
